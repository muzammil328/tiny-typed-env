{
  "name": "tiny-typed-env",
  "version": "2.3.0",
  "description": "Tiny typed environment loader. Zero runtime deps. Built-in schemas or Zod/Valibot. Fails at boot. Works in Node, Bun, Deno, and Workers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    ".env.example"
  ],
  "bin": {
    "tiny-typed-env": "./bin/tiny-typed-env.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "env",
    "environment",
    "environment-variables",
    "typescript",
    "zod",
    "valibot",
    "standard-schema",
    "dotenv",
    "validation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzammil328/tiny-typed-env.git"
  },
  "bugs": {
    "url": "https://github.com/muzammil328/tiny-typed-env/issues"
  },
  "homepage": "https://tiny-typed-env-docs.vercel.app/docs/",
  "author": "Muzammal Safdar",
  "optionalDependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "zod": ">=3.24.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "jiti": "^2.7.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "zod": "^3.24.2"
  }
}
